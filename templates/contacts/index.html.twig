{% extends 'base.html.twig' %}

{% block title %}Contacts index{% endblock %}

{% block body %}
    <h1>Contacts index</h1>

    <table class="table">
        <thead>
            <tr>
                
                <th>Prenom</th>
                <th>Nom</th>
                <th>Naissance</th>
                <th>Tel</th>
                <th>Mail</th>
                <th>Adresse</th>
                <th>Cp</th>
                <th>Ville</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for contact in contacts %}
            <tr>
                
                <td>{{ contact.prenom }}</td>
                <td>{{ contact.nom }}</td>
                <td>{{ contact.naissance ? contact.naissance|date('d/m/Y') : '' }}</td>
                <td>{{ contact.tel }}</td>
                <td><a href="mailto:{{ contact.mail }}">{{contact.mail}}</a></td>
                <td><a href="{{ contact.adresse }}" target=_blank><img src="{{ asset('images/gmaps.png') }}"></a></td>
                <td>{{ contact.cp }}</td>
                <td>{{ contact.ville }}</td>
                <td>
                    <a href="{{ path('app_contacts_show', {'id': contact.id}) }}">show</a>
                    <a href="{{ path('app_contacts_edit', {'id': contact.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_contacts_new') }}">Create new</a>
{% endblock %}
