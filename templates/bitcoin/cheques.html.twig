{% extends 'base.html.twig' %}

{% block title %}bitcoins index{% endblock %}

{% block body %}
    <h1>Cheques</h1>
    <div class="col-8">
   
          <table class="table table-sm table-hover">
       
        <tbody>
        {% for bitcoin in bitcoins %}
            <tr>
               
                <td>{{ bitcoin.cheque}}</td>
                <td>{{ bitcoin.date|date("d/m/Y") }}</td>
                <td><a href='http://localhost:8000/bitcoin/comptes/{{bitcoin.id}}/{{bitcoin.compte}}'>{{ bitcoin.libelle }}</a></td>
               
                <td class="text-end">{{ bitcoin.debit }}</td>
                <td class="text-end">{% if bitcoin.banque %}{{ bitcoin.banque|date("d/m/Y") }}{% endif %}</td>
                <td class="text-end">{{ bitcoin.budget }}</td>
                
            </tr>
        {% endfor %}
       
        
        
        </tbody>
    </table>
    </div>
      
   

{% endblock %}
